# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=

# Per-role models (OpenRouter slugs). Free tier; extractor chosen by the Day 3 bake-off.
# Swap any role to a paid model by changing one line, e.g. EXTRACTOR_MODEL=anthropic/claude-haiku-5.5
EXTRACTOR_MODEL=dots-studio/dots-3-note-preview:free
EXTRACTOR_FALLBACK_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AGENT_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Free endpoints may log prompts. OK for synthetic invoices ONLY. Set false for real data.
ALLOW_PROMPT_LOGGING=true

# Comma-separated provider order to pin; empty = let OpenRouter choose.
PROVIDER_ORDER=
SEED=7
LLM_CACHE_ENABLED=true
LOG_LEVEL=INFO
