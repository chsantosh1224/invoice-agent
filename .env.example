# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=

# Per-role models (OpenRouter slugs). Day 3's bake-off decides the final picks.
# The extractor needs vision; every Nemotron with JSON-schema support is text-only.
EXTRACTOR_MODEL=anthropic/claude-haiku-5.5
AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
JUDGE_MODEL=openai/gpt-5.6-luna

# Comma-separated provider order to pin; empty = let OpenRouter choose.
PROVIDER_ORDER=
SEED=7
LOG_LEVEL=INFO
